<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="category_sales_statement" model="ir.module.category">
        <field name="name">Consulta de cartera comercial</field>
        <field name="sequence">25</field>
    </record>
    <record id="group_statement_reader" model="res.groups">
        <field name="name">Consultar cartera de clientes asignados</field>
        <field name="category_id" ref="category_sales_statement"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_statement_manager" model="res.groups">
        <field name="name">Administrar autorizaciones de cartera</field>
        <field name="category_id" ref="category_sales_statement"/>
        <field name="implied_ids" eval="[(4, ref('group_statement_reader'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
