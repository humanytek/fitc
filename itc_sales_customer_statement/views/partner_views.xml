<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="partner_form_statement" model="ir.ui.view">
        <field name="name">res.partner.form.sales.statement</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="sales_statement_available" invisible="1"
                       groups="itc_sales_customer_statement.group_statement_reader"/>
                <button name="action_itc_sales_customer_statement" type="object"
                        string="Estado de cuenta" class="oe_stat_button" icon="fa-list-alt"
                        groups="itc_sales_customer_statement.group_statement_reader"
                        invisible="not sales_statement_available"/>
            </xpath>
        </field>
    </record>
</odoo>
