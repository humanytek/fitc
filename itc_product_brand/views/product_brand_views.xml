<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_brand_tree" model="ir.ui.view">
        <field name="name">product.brand.tree</field>
        <field name="model">product.brand</field>
        <field name="arch" type="xml">
            <tree string="Marcas" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_product_brand_form" model="ir.ui.view">
        <field name="name">product.brand.form</field>
        <field name="model">product.brand</field>
        <field name="arch" type="xml">
            <form string="Marca">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_product_brand_search" model="ir.ui.view">
        <field name="name">product.brand.search</field>
        <field name="model">product.brand</field>
        <field name="arch" type="xml">
            <search string="Marcas">
                <field name="name"/>
                <field name="code"/>
                <filter name="inactive" string="Archivadas" domain="[('active','=',False)]"/>
            </search>
        </field>
    </record>

    <record id="action_product_brand" model="ir.actions.act_window">
        <field name="name">Marcas</field>
        <field name="res_model">product.brand</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_product_brand_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea la primera marca de producto.</p>
            <p>Este catálogo alimenta productos, análisis de facturación y dashboards.</p>
        </field>
    </record>
</odoo>
