<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_picking_type_form_itc_internal_carta_porte" model="ir.ui.view">
        <field name="name">stock.picking.type.form.itc.internal.carta.porte</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='warehouse_id']" position="after">
                <field name="x_itc_enable_internal_carta_porte"
                       invisible="code != 'internal'"/>
            </xpath>
        </field>
    </record>
</odoo>
